{
  "name": "raylings-vscode",
  "displayName": "Raylings: Master Python Ray",
  "description": "VS Code and Cursor extension for Raylings: learn distributed Python Ray through interactive exercises, progress tracking, and instant execution",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "publisher": "dnf0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnf0/raylings"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:exercises",
    "workspaceContains:solutions",
    "onCommand:raylings.openNextExercise",
    "onCommand:raylings.runCurrent",
    "onCommand:raylings.showHint",
    "onCommand:raylings.startWatcher",
    "onCommand:raylings.initWorkspace",
    "onCommand:raylings.syncProgress",
    "onCommand:raylings.viewSolution",
    "onCommand:raylings.startTour",
    "onCommand:raylings.runDoctor",
    "onCommand:raylings.openExercise",
    "onWalkthrough:raylings.welcome"
  ],
  "contributes": {
    "commands": [
      {
        "command": "raylings.openNextExercise",
        "title": "Open Next Exercise",
        "category": "Raylings"
      },
      {
        "command": "raylings.runCurrent",
        "title": "Run Current Exercise",
        "category": "Raylings"
      },
      {
        "command": "raylings.showHint",
        "title": "Show Exercise Hint",
        "category": "Raylings"
      },
      {
        "command": "raylings.startWatcher",
        "title": "Start Watcher in Terminal",
        "category": "Raylings"
      },
      {
        "command": "raylings.initWorkspace",
        "title": "Initialize Exercises Workspace",
        "category": "Raylings"
      },
      {
        "command": "raylings.viewSolution",
        "title": "View Reference Solution",
        "category": "Raylings"
      },
      {
        "command": "raylings.syncProgress",
        "title": "Sync Progress",
        "category": "Raylings"
      },
      {
        "command": "raylings.startTour",
        "title": "Start Onboarding Tour",
        "category": "Raylings",
        "icon": "$(rocket)"
      },
      {
        "command": "raylings.runDoctor",
        "title": "Run Preflight Diagnostics (Doctor)",
        "category": "Raylings",
        "icon": "$(heart)"
      },
      {
        "command": "raylings.openExercise",
        "title": "Open Exercise File",
        "category": "Raylings"
      }
    ],
    "walkthroughs": [
      {
        "id": "raylings.welcome",
        "title": "Welcome to Raylings",
        "description": "Master Distributed Python and AI Systems with Ray from Scratch",
        "steps": [
          {
            "id": "raylings.welcome.intro",
            "title": "Welcome to Raylings",
            "description": "Master Distributed Python and AI Systems with Ray from Scratch through 81 hands-on exercises.\n[Start Interactive Tour](command:raylings.startTour)",
            "media": {
              "markdown": "walkthroughs/welcome.md"
            },
            "completionEvents": [
              "onCommand:raylings.startTour"
            ]
          },
          {
            "id": "raylings.welcome.environment",
            "title": "Environment Diagnostics",
            "description": "Verify Python 3.10+ requirement, dependencies, and Ray cluster health.\n[Run Doctor Diagnostics](command:raylings.runDoctor)",
            "media": {
              "markdown": "walkthroughs/environment.md"
            },
            "completionEvents": [
              "onCommand:raylings.runDoctor"
            ]
          },
          {
            "id": "raylings.welcome.firstExercise",
            "title": "Your First Exercise",
            "description": "Open `exercises/01_basics/basics01.py`, remove the `# I AM NOT DONE` marker, and execute it.\n[Open First Exercise](command:raylings.openExercise?%22exercises/01_basics/basics01.py%22)",
            "media": {
              "markdown": "walkthroughs/first-exercise.md"
            },
            "completionEvents": [
              "onCommand:raylings.openExercise"
            ]
          },
          {
            "id": "raylings.welcome.watcher",
            "title": "Interactive Watcher Mode",
            "description": "Continuous auto-compilation, real-time feedback, and instant keyboard navigation.\n[Start Watcher](command:raylings.startWatcher)",
            "media": {
              "markdown": "walkthroughs/watcher.md"
            },
            "completionEvents": [
              "onCommand:raylings.startWatcher"
            ]
          },
          {
            "id": "raylings.welcome.treeView",
            "title": "Raylings Explorer Tree View",
            "description": "Explore curriculum chapters, track progress badges, and reveal progressive hints directly from the sidebar.\n[Sync Progress](command:raylings.syncProgress)",
            "media": {
              "markdown": "walkthroughs/tree-view.md"
            },
            "completionEvents": [
              "onCommand:raylings.syncProgress"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "raylings-explorer",
          "title": "Raylings",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "raylings-explorer": [
        {
          "id": "raylings.exerciseTree",
          "name": "Curriculum Exercises"
        }
      ]
    },
    "configuration": {
      "title": "Raylings",
      "properties": {
        "raylings.executablePath": {
          "type": "string",
          "default": "raylings",
          "description": "Path or command to invoke raylings CLI (e.g. 'raylings', 'uv run raylings', 'uvx raylings')"
        },
        "raylings.autoRunOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically evaluate current exercise upon saving"
        },
        "raylings.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Display progress and current exercise in the status bar"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.config.js --minify",
    "build": "node esbuild.config.js --minify",
    "compile": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
